---
import FieldGuideNav from "../components/FieldGuideNav.astro";
import PageTitle from "../components/PageTitle.astro";
import PrevNext from "../components/PrevNext.astro";
import PublicLayout from "./PublicLayout.astro";

interface NavigationEntry {
  href: string;
  title: string;
}

interface Props {
  title: string;
  description?: string;
  prev?: NavigationEntry;
  next?: NavigationEntry;
  format?: "article" | "collection";
}

const { title, description, prev, next, format = "article" } = Astro.props;
const pageTitle = title === "Field Guide" ? title : `${title}`;
---

<PublicLayout title={pageTitle} description={description}>
  <div class="sm:hidden">
    <FieldGuideNav />
  </div>

  <div class="gap-8 pb-16 sm:flex lg:gap-12">
    <aside class="hidden w-56 shrink-0 sm:block lg:w-64">
      <FieldGuideNav />
    </aside>
    <main class:list={["min-w-0 flex-1", format === "article" ? "max-w-3xl" : "max-w-5xl"]}>
      {format === "article" ? (
        <article class="prose">
          <PageTitle>{title}</PageTitle>
          <slot />
          <PrevNext prev={prev} next={next} />
        </article>
      ) : (
        <div class="flex flex-col gap-10">
          <header class="flex flex-col gap-3">
            <PageTitle>{title}</PageTitle>
            {description && (
              <p class="max-w-[65ch] text-pretty text-base text-muted-foreground">
                {description}
              </p>
            )}
          </header>
          <slot />
          <PrevNext prev={prev} next={next} />
        </div>
      )}
    </main>
  </div>
</PublicLayout>
