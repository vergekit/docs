---
import Tag from "../components/Tag.astro";
import PageTitle from "../components/PageTitle.astro";
import { formatDate } from "../utils/content";
import PublicLayout from "./PublicLayout.astro";

interface Props {
  title?: string;
  subtitle?: string;
  date?: Date;
  tags?: string[];
}

const { title, subtitle, date, tags } = Astro.props;
const pageTitle = title ? `${title}` : "Blog";
---

<PublicLayout title={pageTitle} description={subtitle}>
  <div class="pb-16">
    <main class="mx-auto max-w-3xl">
      <article class="prose">
        {title && <PageTitle>{title}</PageTitle>}
        {
          subtitle && (
            <p class="mt-4 text-xl text-muted-foreground">{subtitle}</p>
          )
        }
        {
          date && (
            <div class="mt-4 text-sm text-muted-foreground tabular-nums">
              {formatDate(date)}
            </div>
          )
        }
        {
          tags && tags.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-2">
              {tags.map((tag) => (
                <Tag tag={tag} />
              ))}
            </div>
          )
        }
        <div class="mt-8">
          <slot />
        </div>
      </article>
    </main>
  </div>
</PublicLayout>
