---
import { getCollection, render, type CollectionEntry } from "astro:content";
import FieldGuideLayout from "../../layouts/FieldGuideLayout.astro";
import { entrySlug, getFieldGuidePrevNext } from "../../utils/content";

export async function getStaticPaths() {
  const entries = await getCollection("fieldGuide", ({ data }) => data.status === "published");
  return entries.filter((entry) => entrySlug(entry.id) !== "resources").map((entry) => {
    const slug = entrySlug(entry.id);
    return {
      params: { slug: slug === "index" ? undefined : slug },
      props: { entry },
    };
  });
}

interface Props {
  entry: CollectionEntry<"fieldGuide">;
}

const { entry } = Astro.props;
const slug = entrySlug(entry.id);
const { Content } = await render(entry);
const { prev, next } = await getFieldGuidePrevNext(slug);
---

<FieldGuideLayout
  title={entry.data.title}
  description={entry.data.description}
  prev={prev}
  next={next}
>
  <Content />
</FieldGuideLayout>
