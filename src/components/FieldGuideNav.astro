---
import { getFieldGuideSections } from "../utils/content";
import FieldGuideNavList from "./FieldGuideNavList.astro";
import MobileNavDropdown from "./MobileNavDropdown.astro";

const sections = await getFieldGuideSections();
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const currentEntry = sections
  .flatMap((section) => section.entries)
  .find((entry) => currentPath === entry.href);
const currentPageTitle = currentEntry?.title ?? "Navigate";
---

<MobileNavDropdown id="fieldguide" currentTitle={currentPageTitle} label="Field Guide">
  <FieldGuideNavList sections={sections} currentPath={currentPath} />
</MobileNavDropdown>

<nav class="hidden sm:block" aria-label="Field Guide">
  <FieldGuideNavList sections={sections} currentPath={currentPath} />
</nav>
