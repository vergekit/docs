---
const year = new Date().getFullYear();

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<footer
  class:list={["mt-12 border-t border-border pt-2 pb-3 px-1", className]}
  data-site-footer
  data-pagefind-ignore
>
  <div
    class="flex flex-col items-start gap-3 text-xs text-muted-foreground sm:flex-row sm:items-center sm:justify-between"
  >
    <span>© {year} Verge Kit. All Rights Reserved.</span>
    <a
      class="inline-flex items-center gap-1 font-normal no-underline hover:text-foreground"
      target="_blank"
      rel="noopener"
      href="https://jonathanyoungblood.com/"
      aria-label="Produced by Jonathan Youngblood"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="size-3.5 shrink-0"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          d="m12 21.35-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54z"
        ></path>
      </svg>
      J Y
    </a>
  </div>
</footer>
