---
import "../styles/docs.css";
---

<!-- Keep docs light-only for now. Remove this script and the matching docs.css rule to restore the switcher. -->
<script is:inline>
  (() => {
    document.documentElement.classList.remove("dark");
    try {
      localStorage.setItem("themeMode", "light");
    } catch (_) {}
  })();
</script>

<!-- Start every keyboard-invoked command search with a fresh query. -->
<script is:inline>
  document.addEventListener(
    "keydown",
    (event) => {
      if (!(event.metaKey || event.ctrlKey) || event.key.toLowerCase() !== "k") return;

      const searchInput = document.querySelector("#command-search header input");
      if (searchInput instanceof HTMLInputElement) searchInput.value = "";
    },
    { capture: true },
  );
</script>

<!-- Preserve the docs sidebar position while navigating within the current tab. -->
<script is:inline>
  (() => {
    const storageKey = "rsd:sidebar-scroll-top";

    function initSidebarScrollRestoration() {
      const sidebarScroller = document.querySelector("#sidebar > nav > section");
      if (!(sidebarScroller instanceof HTMLElement)) return;

      try {
        const savedScrollTop = Number(sessionStorage.getItem(storageKey));
        if (Number.isFinite(savedScrollTop)) sidebarScroller.scrollTop = savedScrollTop;
      } catch (_) {}

      window.addEventListener(
        "pagehide",
        () => {
          try {
            sessionStorage.setItem(storageKey, String(sidebarScroller.scrollTop));
          } catch (_) {}
        },
        { once: true },
      );
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initSidebarScrollRestoration, { once: true });
    } else {
      initSidebarScrollRestoration();
    }
  })();
</script>
