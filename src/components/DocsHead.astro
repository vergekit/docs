---
import "../styles/docs.css";

const { absoluteUrl } = Astro.props;
---

<link rel="canonical" href={absoluteUrl} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta
  property="og:image:alt"
  content="Verge Kit crane flying in front of a red sun with the Verge Kit tagline and install command."
/>
<meta
  name="twitter:image:alt"
  content="Verge Kit crane flying in front of a red sun with the Verge Kit tagline and install command."
/>

<!-- Keep docs light-only for now. Remove this script and the matching docs.css rule to restore the switcher. -->
<script is:inline>
  (() => {
    document.documentElement.classList.remove("dark");
    try {
      localStorage.setItem("themeMode", "light");
    } catch (_) {}
  })();
</script>

<!-- Start every keyboard-invoked command search with a fresh query. -->
<script is:inline>
  document.addEventListener(
    "keydown",
    (event) => {
      if (!(event.metaKey || event.ctrlKey) || event.key.toLowerCase() !== "k") return;

      const searchInput = document.querySelector("#command-search header input");
      if (searchInput instanceof HTMLInputElement) searchInput.value = "";
    },
    { capture: true },
  );
</script>

<!-- Open external links in the docs content in a new tab. -->
<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll("#content .prose a[href]").forEach((link) => {
      const url = new URL(link.href, window.location.href);

      if (url.origin !== window.location.origin) {
        link.target = "_blank";
        link.rel = "noopener";
      }
    });
  });
</script>
